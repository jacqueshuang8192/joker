	<bean id="viewResolver"
		class="org.springframework.web.servlet.view.InternalResourceViewResolver">
		<property name="prefix" value="/views/" />
		<property name="suffix" value=".jsp" />
	</bean>

	<mvc:interceptors>
		<mvc:interceptor>
			<mvc:mapping path="/**"/>
			<mvc:exclude-mapping path="/playerUser/OAuthCheck"/>
			<mvc:exclude-mapping path="/playerUser/quickRegister"/>
			<mvc:exclude-mapping path="/playerUser/quickRegisterByPhone"/>
			<mvc:exclude-mapping path="/playerUser/uploadPhoto"/>
			<mvc:exclude-mapping path="/userLogin"/>
<!--			<mvc:exclude-mapping path="/api-docs/**"/>-->
			<mvc:exclude-mapping path="/sfPay/*Callback*"/>
			<mvc:exclude-mapping path="/sfPay/rongZhouPayOrder"/>
			<mvc:exclude-mapping path="/payOrderCallback"/>
			<mvc:exclude-mapping path="/version/queryVersion"/>
			<mvc:exclude-mapping path="/roomCard/deductCard"/>
			<mvc:exclude-mapping path="/freeGame/A2IcreateFreeGame"/>
			<bean class="com.hbi.interceptor.TokenInterceptor"></bean>
		</mvc:interceptor>
	</mvc:interceptors>

</beans>