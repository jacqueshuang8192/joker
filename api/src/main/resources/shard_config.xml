<?xml version="1.0" encoding="UTF-8"?>  
<!DOCTYPE shardingConfig PUBLIC "-//shardbatis.googlecode.com//DTD Shardbatis 2.0//EN"  
  "http://shardbatis.googlecode.com/dtd/shardbatis-config.dtd">
<shardingConfig>
	<!-- parseList可选配置 如果配置了parseList,只有在parseList范围内并且不再ignoreList内的sql才会被解析和修改 -->
	<parseList>
		<value>com.hbi.mapper.GameInfoMapper.selectById</value>
		<value>com.hbi.mapper.GameInfoMapper.createUser</value>
		<value>com.hbi.mapper.BullFightGameInfoMapper.selectById</value>
		<value>com.hbi.mapper.BullFightGameInfoMapper.createUser</value>
	</parseList>

	
	<!-- 配置分表策略 -->
	<strategy tableName="bullfight_gameinfo" strategyClass="com.hbi.shardbatis.ShardStrategyImpl" />
</shardingConfig>  

