<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.hbi.mapper.TTypeGameMapper">
	<select id="selectAgentByProvinceId" resultType="Long">
		SELECT
		default_agent
		FROM
		t_game_province
		WHERE
		province_id = #{provinceId}
	</select>

	
</mapper>