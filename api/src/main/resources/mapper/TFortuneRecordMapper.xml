<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.j.joker.mapper.TFortuneRecordMapper" >
    <select id="queryRecord" resultType="com.j.joker.model.TFortuneRecord">
        SELECT
        *
        FROM
        t_fortune_record
        WHERE
        user_id = #{userId}
        ORDER BY
        date
        DESC
        limit 0,10
    </select>
</mapper>