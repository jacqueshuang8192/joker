; 房间分配服务使用的用户服务地址表。ServerCount 对应编号 0 至 9 的条目数，目前都指向同一个 user 进程。
[UserServer]
ServerCount=10
UserServer_0=127.0.0.1:7500
UserServer_1=127.0.0.1:7500
UserServer_2=127.0.0.1:7500
UserServer_3=127.0.0.1:7500
UserServer_4=127.0.0.1:7500
UserServer_5=127.0.0.1:7500
UserServer_6=127.0.0.1:7500
UserServer_7=127.0.0.1:7500
UserServer_8=127.0.0.1:7500
UserServer_9=127.0.0.1:7500

; 服务缓存地址由 1Panel 的 Memcached 主机和端口生成。
[MEMCACHED]
SERVER_MC=@MEMCACHED_HOST@:@MEMCACHED_PORT@

; 原生程序的 Redis 兼容地址。面板部署时，启动器从 redis.json 传入实际地址和认证信息。
[SERVER_REDIS]
HOST=127.0.0.1
PORT=6379

; 私人房服务编号映射。COUNT 为映射对数，相同后缀的 SID 与 SID_MAPPED 分别为原编号和映射后的编号。
[PRIVATEROOM_SID_MAP]
COUNT=11
SID1=1001
SID_MAPPED1=21
SID2=1002
SID_MAPPED2=22
SID3=1003
SID_MAPPED3=23
SID4=1004
SID_MAPPED4=24
SID5=1005
SID_MAPPED5=25
SID6=1006
SID_MAPPED6=26
SID7=1007
SID_MAPPED7=27
SID8=1008
SID_MAPPED8=28
SID9=1009
SID_MAPPED9=29
SID10=1010
SID_MAPPED10=30
SID11=31001
SID_MAPPED11=621

; 私人房可选底注。COUNT 为档位数，从 BASECHIP1 起依次列出。
[PRIVATEROOM_BASECHIP]
COUNT=5
BASECHIP1=100
BASECHIP2=200
BASECHIP3=500
BASECHIP4=1000
BASECHIP5=5000

; 双倍底注模式的独立档位列表，按 COUNT 读取。
[PRIVATEROOM_DOUBLE_BASECHIP]
COUNT=4
BASECHIP1=10000
BASECHIP2=60000
BASECHIP3=100000
BASECHIP4=200000


; 房间列表的数量上限。COUNT 用于普通私人房，LOVEGIRL_COUNT 用于旧版 LOVEGIRL 房间列表。
[PRIVATEROOM_MAX_LIST]
COUNT=10
LOVEGIRL_COUNT=50

; 私人房收费与门槛。COUNT 为档位数，同一数字后缀的字段属于同一档。
; 按原生结构定义，BASE_CHIP 为底注，LOW_MONEY 为出局金币数，TABLE_COST 为台费，OUT_MONEY 为最低入场金币数。
[PRIVATEROOM]
COUNT=4
BASE_CHIP_1=100
LOW_MONEY_1=15000
TABLE_COST_1=250
OUT_MONEY_1=700

BASE_CHIP_2=1000
LOW_MONEY_2=20000
TABLE_COST_2=2500
OUT_MONEY_2=5000


BASE_CHIP_3=10000
LOW_MONEY_3=40000
TABLE_COST_3=20000
OUT_MONEY_3=40000


BASE_CHIP_4=20000
LOW_MONEY_4=80000
TABLE_COST_4=40000
OUT_MONEY_4=80000
